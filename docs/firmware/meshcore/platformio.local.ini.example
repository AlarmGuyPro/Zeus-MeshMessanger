; Mesh Messenger: MeshCore Wi-Fi companion build for a Zeus node.
;
; Copy this file into the root of your MeshCore checkout as
; "platformio.local.ini" (MeshCore loads it automatically and Git ignores it),
; then put your 2.4 GHz Wi-Fi name and password in the two marked lines of the
; section for your board. Keep the quotes exactly as shown: '"...."'
;
; In VS Code: PlatformIO sidebar > Project Tasks > zeus_meshcore_v4 > Upload
; (Plain Upload keeps the node's identity, name, radio and channels.
;  Don't use Erase Flash.)
;
; Based on [env:heltec_v4_companion_radio_wifi] in MeshCore companion-v1.17.1,
; copied in full rather than overridden so the result is predictable.
; Port 5000 is MeshCore's default for Wi-Fi companions.

; ---- Heltec V4 (standard, 2 MB PSRAM) ----
[env:zeus_meshcore_v4]
extends = heltec_v4_oled
build_flags =
  ${heltec_v4_oled.build_flags}
  -I examples/companion_radio/ui-new
  -D MAX_CONTACTS=350
  -D MAX_GROUP_CHANNELS=40
  -D OFFLINE_QUEUE_SIZE=256
  -D DISPLAY_CLASS=SSD1306Display
  -D WIFI_DEBUG_LOGGING=1
  -D WIFI_SSID='"YourWiFiName"'          ; <-- your Wi-Fi name
  -D WIFI_PWD='"YourWiFiPassword"'       ; <-- your Wi-Fi password
build_src_filter = ${heltec_v4_oled.build_src_filter}
  +<helpers/ui/SSD1306Display.cpp>
  +<helpers/ui/MomentaryButton.cpp>
  +<helpers/esp32/*.cpp>
  +<../examples/companion_radio/*.cpp>
  +<../examples/companion_radio/ui-new/*.cpp>
lib_deps =
  ${heltec_v4_oled.lib_deps}
  densaugeo/base64 @ ~1.4.0

; ---- Heltec V4 R8 (8 MB PSRAM) ----
[env:zeus_meshcore_v4_r8]
extends = heltec_v4_r8_oled
build_flags =
  ${heltec_v4_r8_oled.build_flags}
  -I examples/companion_radio/ui-new
  -D MAX_CONTACTS=350
  -D MAX_GROUP_CHANNELS=40
  -D OFFLINE_QUEUE_SIZE=256
  -D DISPLAY_CLASS=SSD1306Display
  -D WIFI_DEBUG_LOGGING=1
  -D WIFI_SSID='"YourWiFiName"'          ; <-- your Wi-Fi name
  -D WIFI_PWD='"YourWiFiPassword"'       ; <-- your Wi-Fi password
build_src_filter = ${heltec_v4_r8_oled.build_src_filter}
  +<helpers/ui/SSD1306Display.cpp>
  +<helpers/ui/MomentaryButton.cpp>
  +<helpers/esp32/*.cpp>
  +<../examples/companion_radio/*.cpp>
  +<../examples/companion_radio/ui-new/*.cpp>
lib_deps =
  ${heltec_v4_r8_oled.lib_deps}
  densaugeo/base64 @ ~1.4.0
