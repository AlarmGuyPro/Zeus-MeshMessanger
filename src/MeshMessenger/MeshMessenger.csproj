<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MeshMessenger</AssemblyName>
    <RootNamespace>MeshMessenger</RootNamespace>
    <Version>0.4.0</Version>
    <IsPackable>false</IsPackable>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../sdk/Zeussdr.Zeus.Plugins.Contracts/Zeus.Plugins.Contracts.csproj"
                      Private="false" />
  </ItemGroup>
  <!-- The mesh library lives under Mesh/ inside this project rather than in a
       project of its own. Two reasons: the package then ships one assembly,
       which the catalog scan prefers (every extra DLL is flagged for a
       reviewer), and the source-rebuild check allows neither '..' in an item
       path nor LinkBase metadata, which is what linking it in from a sibling
       project required. Default globbing picks it up; no Compile items needed. -->
</Project>
