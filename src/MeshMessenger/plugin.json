{
  "schemaVersion": 1,
  "id": "io.github.alarmguypro.meshmessenger",
  "name": "Mesh Messenger",
  "version": "0.1.0",
  "author": "KQ4WLR",
  "description": "Read, send and reply to Meshtastic and MeshCore messages through Wi-Fi-connected LoRa nodes, in one inbox that keeps each network separate.",
  "homepage": "https://github.com/AlarmGuyPro/Zeus-MeshMessanger",
  "license": "GPL-3.0-or-later",
  "sdk": { "abi": 1, "minVersion": "1.5.0" },
  "entrypoint": {
    "assembly": "MeshMessenger.dll",
    "type": "MeshMessenger.MeshMessengerPlugin"
  },
  "capabilities": ["NetworkAccess", "PersistSettings"],
  "permissions": {
    "network": true,
    "fileSystemRead": false,
    "fileSystemWrite": false
  },
  "ui": {
    "modules": ["ui/meshmessenger.js"],
    "panels": [
      {
        "id": "meshmessenger",
        "title": "Mesh Messenger",
        "slot": "workspace.meshmessenger",
        "category": "tools"
      }
    ]
  }
}
